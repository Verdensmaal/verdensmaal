<!DOCTYPE html>
<html lang="da" class="no-js">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<script>(function(html){html.className = html.className.replace(/\bno-js\b/,'js')})(document.documentElement);</script>
	<title>{% if home %}Verdensmål i Hverdagsliv{% else %}{{ title }} – Verdensmål i Hverdagsliv{% endif %}</title>
	{% if description %}<meta name="description" content="{{ description }}">{% endif %}
	<link rel="stylesheet" href="/assets/block-library/style.min.css">
	<link rel="stylesheet" href="/assets/block-library/theme.min.css">
	<link rel="stylesheet" href="/assets/twentysixteen/fonts/merriweather-plus-montserrat-plus-inconsolata.css">
	<link rel="stylesheet" href="/assets/twentysixteen/genericons/genericons.css">
	<link rel="stylesheet" href="/assets/twentysixteen/style.css">
	<link rel="stylesheet" href="/assets/twentysixteen/css/blocks.css">
</head>

<body class="{{ bodyClass }} wp-custom-logo wp-embed-responsive group-blog{% if home %} home{% endif %}{% if wpId %} {{ 'postid-' if 'single' in bodyClass else 'page-id-' }}{{ wpId }}{% endif %}">
{% from "menu.njk" import renderMenu %}
{% set mainMenu = menu | menuState(page.url) %}
<div id="page" class="site">
	<div class="site-inner">
		<a class="skip-link screen-reader-text" href="#content">Videre til indhold</a>

		<header id="masthead" class="site-header">
			<div class="site-header-main">
				<div class="site-branding">
					<a href="/" class="custom-logo-link" rel="home"><img width="240" height="240" src="/wp-content/uploads/2019/06/cropped-IphoneIkon-1.jpg" class="custom-logo" alt="Verdensmål i Hverdagsliv" srcset="/wp-content/uploads/2019/06/cropped-IphoneIkon-1.jpg 240w, /wp-content/uploads/2019/06/cropped-IphoneIkon-1-150x150.jpg 150w" sizes="(max-width: 240px) 85vw, 240px"></a>
				</div><!-- .site-branding -->

				<button id="menu-toggle" class="menu-toggle">Menu</button>

				<div id="site-header-menu" class="site-header-menu">
					<nav id="site-navigation" class="main-navigation" aria-label="Primær menu">
						{{ renderMenu(mainMenu, "menu-top-menu") }}
					</nav><!-- .main-navigation -->
				</div><!-- .site-header-menu -->
			</div><!-- .site-header-main -->
		</header><!-- .site-header -->

		<div id="content" class="site-content">

<div id="primary" class="content-area">
	<main id="main" class="site-main">
		{{ content | safe }}
	</main><!-- .site-main -->

	{% include "content-bottom.njk" %}
</div><!-- .content-area -->

{% include "sidebar.njk" %}
		</div><!-- .site-content -->

		<footer id="colophon" class="site-footer">
			<nav class="main-navigation" aria-label="Footer, Primær menu">
				{{ renderMenu(mainMenu, "") }}
			</nav><!-- .main-navigation -->

			<div class="site-info">
				<span class="site-title"><a href="/" rel="home">Verdensmål i Hverdagsliv</a></span>
			</div><!-- .site-info -->
		</footer><!-- .site-footer -->
	</div><!-- .site-inner -->
</div><!-- .site -->
<script src="/assets/js/navigation.js" defer></script>
</body>
</html>
